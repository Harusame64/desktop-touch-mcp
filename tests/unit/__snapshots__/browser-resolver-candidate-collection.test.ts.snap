  function __skipsText(c) { return __matches(c, __NOT_TEXT) && __drawsNothing(c, false); }

  function __isMasked(el) {
    if (el.tagName === 'INPUT') {
      const t = (el.type || '').toLowerCase();
      if (t === 'password') return true;
