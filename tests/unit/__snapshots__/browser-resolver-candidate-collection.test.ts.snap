    const toks = (el.getAttribute('data-dtm-ax') || '').split(' ');
    for (let i = 0; i < toks.length; i++) {
      const v = toks[i].split(':');
      if (v[0] === axMark) return { score: parseFloat(v[1]) || 0.7, control: v[2] === 'c', role: v[3] || '' };
