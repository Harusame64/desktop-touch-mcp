#!/bin/sh
# Two refusals before anything reaches the server:
#   1. Direct push to main. Set DESKTOP_TOUCH_ALLOW_MAIN_PUSH=1 to bypass
#      (release flow only — see docs/release-process.md and CLAUDE.md 強制命令 8).
#   2. A Claude session id in a commit message (repo policy, user decision
#      2026-09-08: no session IDs in the public repo).
#      `.githooks/commit-msg` removes those at commit time, so this is not a
#      second copy of that check — it covers what that hook cannot see:
#        - `git rebase` does NOT re-run commit-msg. It carries existing commits
#          forward as they are, so a trailer written before the hook existed, or
#          on a branch where it was skipped, reaches a public branch untouched.
#        - `git commit --no-verify` skips commit-msg outright.
#      (`git commit --amend` DOES re-run it, so that path is already covered.)
#      This one refuses rather than rewrites: the line is inside a commit by
#      now, and rewriting history under the author's feet is not a hook's job.
#      It also runs without node, which the commit-msg hook needs.

remote_name="$1"
protected_branch="refs/heads/main"
zero="0000000000000000000000000000000000000000"
session_pattern='^[[:space:]]*([-*][[:space:]]+)?(Claude-Session:|https://claude[.]ai/code/session_)'

# What counts as "already published" for the push in front of us. git passes the
# remote's name as $1 (or its URL, when pushing to one directly).
#
# This must name ONE remote. `--remotes` with no value excludes everything
# reachable from ANY remote-tracking ref, so a commit carrying a trailer that
# exists only on some other remote — a fork you have fetched — is excluded from
# the range and lands on this one unchecked. Pinning it to `origin` had the
# opposite fault: in a clone whose remote is named otherwise it excluded
# nothing, and every new-branch push was refused over the old commits.
if [ -n "$remote_name" ] && git config --get "remote.$remote_name.url" >/dev/null 2>&1; then
    published="--remotes=$remote_name"
else
    # Pushed to a URL, or a remote this clone does not have configured. There
    # are no remote-tracking refs to trust, so nothing is excluded and old
    # commits may trip the check below — the message there says what to do.
    published=""
fi

while read local_ref local_oid remote_ref remote_oid
do
    # Deleting a ref pushes no commits.
    if [ "$local_oid" = "$zero" ]; then
        continue
    fi

    if [ "$remote_ref" = "$protected_branch" ]; then
        if [ "${DESKTOP_TOUCH_ALLOW_MAIN_PUSH:-0}" != "1" ]; then
            echo "" >&2
            echo "ERROR: direct push to main is forbidden." >&2
            echo "  - Use a feature branch + PR (CLAUDE.md 強制命令 8)." >&2
            echo "  - Release flow may bypass with DESKTOP_TOUCH_ALLOW_MAIN_PUSH=1" >&2
            echo "    (see docs/release-process.md)." >&2
            echo "" >&2
            exit 1
        else
            echo "WARNING: DESKTOP_TOUCH_ALLOW_MAIN_PUSH=1 — bypassing main protection." >&2
        fi
    fi

    # Only the commits this push would add. A brand-new branch has no remote
    # counterpart, so what is already on this remote is excluded instead.
    if [ "$remote_oid" = "$zero" ]; then
        range="$local_oid --not $published"
    else
        range="$remote_oid..$local_oid"
    fi

    # One `git log`, into a file, so that its failure and grep's are told apart.
    # `grep -c` exits 1 when it finds nothing, which is the good case; in a
    # single pipeline `|| leaked=0` could not distinguish that from git failing,
    # from grep being absent, or from a locale error — every one of which then
    # read as "nothing found" and let the push through. `remote_oid` comes from
    # the remote's live advertisement and can name an object this clone does not
    # have, so a stale fetch was enough to reach it.
    # Inside the repository's own git dir rather than a world-writable /tmp:
    # the fallback name was predictable, so on a shared host another local user
    # could pre-create it as a symlink and the redirect below would follow it.
    subjects=$(mktemp 2>/dev/null) ||
        subjects="$(git rev-parse --git-dir)/pre-push-session-scan.$$"
    if ! git log $range --format=%B >"$subjects" 2>/dev/null; then
        rm -f "$subjects"
        echo "" >&2
        echo "ERROR: could not inspect the commits being pushed." >&2
        echo "  This failed: git log $range" >&2
        echo "  The range names an object this clone may not have yet." >&2
        echo "  Refusing rather than pushing unchecked — run 'git fetch' and retry." >&2
        echo "" >&2
        exit 1
    fi

    # LC_ALL=C pins what `[[:space:]]` means. Under a UTF-8 locale glibc grep
    # also accepts U+3000 there, which the JS side does not — the two engines
    # have to read the pattern the same way for the tests to mean anything.
    leaked=$(LC_ALL=C grep -c -E "$session_pattern" <"$subjects")
    grep_status=$?
    rm -f "$subjects"

    # A successful `grep -c` always prints a number. An empty result means the
    # redirect itself failed — which the shell reports as status 1, the same
    # status as "found nothing", so the count is what tells them apart.
    if [ -z "$leaked" ]; then
        echo "" >&2
        echo "ERROR: could not read back the commit messages to scan them." >&2
        echo "  Refusing rather than pushing unchecked." >&2
        echo "" >&2
        exit 1
    fi

    # 0 = found some, 1 = found none, anything else = grep itself failed.
    if [ "$grep_status" -gt 1 ]; then
        echo "" >&2
        echo "ERROR: could not scan the commit messages (grep exited $grep_status)." >&2
        echo "  Refusing rather than pushing unchecked." >&2
        echo "" >&2
        exit 1
    fi

    if [ "${leaked:-0}" -gt 0 ]; then
        echo "" >&2
        echo "ERROR: $leaked commit message line(s) in this push carry a Claude session id." >&2
        echo "  Repo policy: no session IDs in the public repo." >&2
        echo "  This is what .githooks/commit-msg strips — it was skipped (--no-verify?)." >&2
        echo "  Reword them before pushing — 'git commit --amend' for the tip," >&2
        echo "  'git rebase' for anything older. To list what is in this push:" >&2
        echo "    git log $range --format='%h %s'" >&2
        echo "  If these are old commits already on the remote, 'git fetch' first:" >&2
        echo "  without its remote-tracking refs this cannot tell them from new ones." >&2
        echo "" >&2
        exit 1
    fi
done

exit 0
